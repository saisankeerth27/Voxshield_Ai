# Environment files — never commit real secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data / model weights / audio storage (never expose uploads or processed audio)
# NOTE: a bare `models/` pattern would also ignore backend/app/models/ (the
# SQLAlchemy ORM models), so ML weight dirs are scoped explicitly below.
/models/
backend/models/
uploads/
backend/uploads/
processed_audio/
backend/processed_audio/
logs/
*.db
tmp/

# Build output
dist/
build/

# Frontend
frontend/dist/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Misc
*.log
coverage/
htmlcov/
