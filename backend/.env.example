# VoiceShield backend configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# Application
APP_NAME=VoiceShield
DEBUG=true

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/voiceshield

# Security tokens (reserved for future phases; not used yet)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Audio uploads
MAX_AUDIO_SIZE_MB=25
UPLOAD_DIR=uploads

# Audio preprocessing
TARGET_SAMPLE_RATE=16000
MIN_AUDIO_DURATION_SECONDS=1
MAX_AUDIO_DURATION_SECONDS=300
PROCESSED_AUDIO_DIR=processed_audio
# RMS floor (dB) below which a signal is treated as silence
SILENCE_THRESHOLD_DB=-50
# librosa top_db used to trim leading/trailing silence
TRIM_TOP_DB=35
# Optional explicit FFmpeg binary path (empty: auto-resolve system/PATH)
FFMPEG_PATH=

# Deepfake / synthetic voice detection (ML)
# Fine-tuned Wav2Vec2 (real vs AI TTS / voice-cloning audio). Weights are
# downloaded once via Hugging Face Hub on first use and cached in
# MODEL_CACHE_DIR (never committed).
DEEPFAKE_MODEL_NAME=garystafford/wav2vec2-deepfake-voice-detector
# Device resolution: auto | cpu | cuda
MODEL_DEVICE=auto
# Hugging Face cache directory for downloaded weights
MODEL_CACHE_DIR=models
# Long-audio segmentation before inference
MODEL_CHUNK_SECONDS=30
MODEL_OVERLAP_SECONDS=0
MODEL_MIN_CHUNK_SECONDS=0.5

# Speaker verification (ECAPA-TDNN speaker recognition)
# SpeechBrain model. Weights are downloaded once on first use into
# SPEAKER_MODEL_SAVEDIR (never committed).
SPEAKER_MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_MODEL_SAVEDIR=models/speaker
# Similarity threshold (MVP default, NOT scientifically calibrated for this
# dataset - tune on representative validation data before production use).
SPEAKER_SIMILARITY_THRESHOLD=0.25
# Minimum speech duration (16 kHz) for a reliable speaker embedding.
MIN_SPEAKER_DURATION_SECONDS=1
